# ── Server Configuration ───────────────────────────────────────────────
PORT=8080

# ── Database Configuration ─────────────────────────────────────────────
# Dokploy PostgreSQL URL:
# postgres://<user>:<password>@<dokploy-postgres-host>:5432/<database>?sslmode=disable
DATABASE_URL=postgres://postgres:password@jaagrmind-postgres:5432/jaagrmind?sslmode=disable

# ── Authentication & Security ──────────────────────────────────────────
# Set a strong 64-character random string for production
JWT_SECRET=generate-a-strong-random-secret-key-here

# Allowed CORS origins (comma-separated)
FRONTEND_URL=https://app.jaagrmind.com,https://jaagrmind.com,https://www.jaagrmind.com

# Base URL used for transactional email links
FRONTEND_BASE_URL=https://app.jaagrmind.com

# ── Transactional Email (Resend) ───────────────────────────────────────
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# ── Object Storage (Oracle Cloud S3-Compatible) ────────────────────────
STORAGE_PROVIDER=oracle
ORACLE_ACCESS_KEY_ID=your_oracle_access_key
ORACLE_SECRET_ACCESS_KEY=your_oracle_secret_key
ORACLE_REGION=ap-hyderabad-1
ORACLE_S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-hyderabad-1.oraclecloud.com
ORACLE_BUCKET=your_bucket_name

# ── Google OAuth 2.0 (Individual & Family Desk) ────────────────────────
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://api.jaagrmind.com/api/auth/google/callback
